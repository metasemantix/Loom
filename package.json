{
  "name": "loom-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply loom-local --local",
    "db:migrate:production": "wrangler d1 migrations apply loom-production --remote --config wrangler.production.jsonc",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "deploy:check": "wrangler deploy --config wrangler.production.example.jsonc --dry-run --outdir .wrangler/deploy-check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^5.20260812.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.30.0"
  }
}
