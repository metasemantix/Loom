{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loom",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loom-production",
      "database_id": "7053954f-8ff6-411b-8a42-d03b33e81bf0",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "replace-with-discord-application-id",
    "DISCORD_REDIRECT_URI": "https://loom.replace-with-workers-subdomain.workers.dev/auth/discord/callback",
    "ACCOUNT_DELETION_GRACE_SECONDS": "259200"
  },
  "secrets": {
    "required": [
      "DISCORD_CLIENT_SECRET"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
